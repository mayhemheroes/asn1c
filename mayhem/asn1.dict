# ASN.1 grammar dictionary for the asn1c parser fuzzer.
# Keywords and punctuation from the ASN.1 grammar (libasn1parser/asn1p_y.y), to help
# libFuzzer/Mayhem build syntactically-meaningful inputs that reach deeper parser states.
kw_definitions="DEFINITIONS"
kw_begin="BEGIN"
kw_end="END"
kw_imports="IMPORTS"
kw_exports="EXPORTS"
kw_from="FROM"
kw_integer="INTEGER"
kw_boolean="BOOLEAN"
kw_null="NULL"
kw_enumerated="ENUMERATED"
kw_sequence="SEQUENCE"
kw_set="SET"
kw_of="OF"
kw_choice="CHOICE"
kw_optional="OPTIONAL"
kw_default="DEFAULT"
kw_octet="OCTET"
kw_bit="BIT"
kw_string="STRING"
kw_object="OBJECT"
kw_identifier="IDENTIFIER"
kw_real="REAL"
kw_true="TRUE"
kw_false="FALSE"
kw_size="SIZE"
kw_with="WITH"
kw_components="COMPONENTS"
kw_constrained="CONSTRAINED"
kw_by="BY"
kw_class="CLASS"
kw_unique="UNIQUE"
kw_min="MIN"
kw_max="MAX"
kw_explicit="EXPLICIT"
kw_implicit="IMPLICIT"
kw_automatic="AUTOMATIC"
kw_tags="TAGS"
kw_universal="UNIVERSAL"
kw_application="APPLICATION"
kw_private="PRIVATE"
kw_utf8="UTF8String"
kw_relative_oid="RELATIVE-OID"
kw_assign="::="
ellipsis="..."
two_dots=".."
lbrace="{"
rbrace="}"
lparen="("
rparen=")"
lbrack="["
rbrack="]"
pipe="|"
comma=","
semicolon=";"
at="@"
amp="&"
